# Required application configuration
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"
ADMIN_PASSCODE="change-me"
ADMIN_SESSION_SECRET="change-me-use-at-least-32-random-characters"
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# Keep enabled until real executive email routing is configured.
TEST_MODE="true"

# Optional SMTP configuration
SMTP_HOST="change-me"
SMTP_PORT="587"
SMTP_USER="change-me"
SMTP_PASS="change-me"
MAIL_FROM="NACOSS Hub <noreply@example.com>"

# Optional policy configuration
DECISION_DIGEST_PUBLISH_DELAY_HOURS="0"
TREASURER_SPENDING_APPROVAL_LIMIT="50000"
