# NACOS Hub Environment Variables

# SQLite Database Location
DATABASE_URL="file:./dev.db"

# TEST_MODE flag (default: true)
# When TEST_MODE=true, concerns addressed to offices with placeholder emails
# (*@nacos-unilag.example) are routed to the General Secretary's real testing email:
# sanayodeji087@gmail.com
TEST_MODE=true

# SMTP Configuration for Nodemailer (Optional)
# If left blank, Nodemailer defaults to DEV LOG MODE (logs full email payload to server console without crashing).
#
# To configure Gmail SMTP:
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 3. Create an App Password for "Mail" / "NACOS Hub"
# 4. Fill in the credentials below:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="sanayodeji087@gmail.com"
SMTP_PASS="your-16-character-app-password"
MAIL_FROM="NACOS UNILAG Hub <sanayodeji087@gmail.com>"

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Access Passcode (Prototype only - replace with per-exec accounts in production)
ADMIN_PASSCODE="set-a-local-demo-passcode"
ADMIN_SESSION_SECRET="generate-a-unique-random-secret-at-least-32-characters"
